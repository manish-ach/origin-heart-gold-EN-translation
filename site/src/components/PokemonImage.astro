---
import { referenceArtwork } from '../../../work/save-editor/src/ui/artwork';
import { speciesById, type Species } from '../lib/data';
// `art`: small images are thumbnails (48 to 64 px) and load the 96 px sprite (W-050). Decorative heroes that stretch a
// small image pass art="artwork". On error the script below tries the HOME artwork, then the official artwork, then a
// placeholder (src/lib/pokemon-art.ts). The fallbacks are built from `data-art` (the species id) to keep long tables light.
const { s, size = 'small', loading = 'lazy', inline = false, art: kind = size === 'large' ? 'artwork' : 'sprite', priority = false } = Astro.props as { s: Species; size?: 'small' | 'large'; loading?: 'lazy' | 'eager'; inline?: boolean; art?: 'sprite' | 'artwork'; priority?: boolean };
const Frame = inline ? 'span' : 'figure';
const Caption = inline ? 'span' : 'figcaption';
const art = referenceArtwork(s.baseSpeciesId, s.formId);
const large = size === 'large';
const sprite = kind === 'sprite';
const baseName = speciesById.get(s.baseSpeciesId)?.name ?? `species #${s.baseSpeciesId}`;
const label = art?.baseFallback ? `${baseName} standard-form artwork` : `${s.name} artwork`;
---
<Frame class={`pokemon-image pokemon-image-${size}`}>
  {art ? <img src={sprite ? art.sprite : art.src} class={sprite ? 'pokemon-sprite' : undefined} data-art={sprite ? s.baseSpeciesId : `${s.baseSpeciesId}h`} alt={large ? label : ''} aria-hidden={large ? undefined : 'true'} width={large ? 256 : 48} height={large ? 256 : 48} loading={loading} decoding="async" fetchpriority={priority ? 'high' : undefined} /> : <span class="art-placeholder" role={large ? 'img' : undefined} aria-label={large ? 'Artwork unavailable' : undefined} aria-hidden={large ? undefined : 'true'}>—</span>}
  {art?.baseFallback && <Caption class={large ? 'small muted' : 'sr-only'}>Artwork shows {baseName}’s standard form.</Caption>}
  {large && <Caption class="small muted">Artwork: <a href="https://github.com/PokeAPI/sprites">PokéAPI</a>.</Caption>}
</Frame>
<script>
import { setupArtwork } from '../lib/pokemon-art';
setupArtwork();
document.addEventListener('astro:page-load', () => setupArtwork());
</script>
