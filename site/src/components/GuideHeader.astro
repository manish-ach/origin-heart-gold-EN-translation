---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import PrimaryNav from './PrimaryNav.astro';
import '../styles/time-hints.css';
const { hasSidebar } = Astro.locals.starlightRoute;
---
<div class="guide-header">
  {hasSidebar && <button class="guide-menu" type="button" aria-label="Collapse guide sidebar" aria-expanded="true" aria-controls="starlight__sidebar">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
  </button>}
  <DefaultHeader><slot /></DefaultHeader>
  <PrimaryNav variant="bar" />
  {!hasSidebar && <>
    {/* Pages without a sidebar (home, 404) have no navigation drawer: this Menu opens the main destinations
        and the theme choice. A popover works without JavaScript; the script adds a fallback for older browsers. */}
    <button class="primary-menu-button" type="button" popovertarget="primary-menu" aria-controls="primary-menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
      <span>Menu</span>
    </button>
    <div class="primary-menu" id="primary-menu" popover>
      <PrimaryNav variant="panel" />
      <div class="primary-menu-prefs"><div class="primary-menu-social"><SocialIcons /></div><ThemeSelect /></div>
    </div>
  </>}
</div>
<script>
  import { setupTimeHints } from '../lib/time-hints-ui.mjs';
  setupTimeHints();
  const button = document.querySelector<HTMLButtonElement>('.guide-menu');
  if (button) {
    const update = (collapsed: boolean) => {
      document.documentElement.toggleAttribute('data-sidebar-collapsed', collapsed);
      button.setAttribute('aria-expanded', String(!collapsed));
      button.setAttribute('aria-label', `${collapsed ? 'Expand' : 'Collapse'} guide sidebar`);
    };
    let collapsed = false;
    try { collapsed = localStorage.getItem('ohg-sidebar-collapsed') === 'true'; } catch {}
    update(collapsed);
    button.addEventListener('click', () => {
      collapsed = !collapsed;
      update(collapsed);
      try { localStorage.setItem('ohg-sidebar-collapsed', String(collapsed)); } catch {}
    });
  }

  // The Menu panel: a native popover (light dismiss and Escape built in) with a fallback for browsers without it.
  const menuButton = document.querySelector<HTMLButtonElement>('.primary-menu-button');
  const menu = document.getElementById('primary-menu');
  if (menuButton && menu) {
    const native = typeof menu.showPopover === 'function';
    let fallbackOpen = false;
    const isOpen = () => native ? menu.matches(':popover-open') : fallbackOpen;
    const sync = () => {
      menuButton.setAttribute('aria-expanded', String(isOpen()));
      menu.toggleAttribute('data-open', isOpen());
    };
    const close = (refocus = false) => {
      if (native && menu.matches(':popover-open')) menu.hidePopover();
      fallbackOpen = false;
      sync();
      if (refocus) menuButton.focus();
    };
    menuButton.addEventListener('click', (event) => {
      if (native) return; // popovertarget toggles it; the toggle event syncs the state
      event.preventDefault();
      fallbackOpen = !fallbackOpen;
      sync();
    });
    menu.addEventListener('toggle', () => sync());
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });
    document.addEventListener('click', (event) => {
      if (!native && fallbackOpen && event.target instanceof Node && !menu.contains(event.target) && !menuButton.contains(event.target)) close();
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a[href]')) close();
    });
    matchMedia('(min-width: 78rem)').addEventListener('change', () => close());
    window.addEventListener('pageshow', () => close());
    sync();
  }
</script>
<style>
  .guide-header { display: flex; align-items: center; gap: 1rem; height: 100%; }
  .guide-header :global(.header) { flex: 1; min-width: 0; }
  .guide-menu { display: none; align-items: center; justify-content: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: transparent; color: var(--sl-color-text); cursor: pointer; }
  .guide-menu:hover, .primary-menu-button:hover { background: var(--sl-color-gray-6); }
  .guide-menu:focus-visible, .primary-menu-button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 3px; }
  @media (min-width: 50rem) { .guide-menu { display: flex; } }

  /* The main destinations sit in the bar when there is room. Below that they are in the Menu panel (pages without a
     sidebar) or at the top of the navigation drawer (pages with one; between 50rem and 78rem the sidebar is open). */
  .guide-header > :global(.primary-nav-bar) { display: none; flex-shrink: 0; }
  @media (min-width: 78rem) { .guide-header > :global(.primary-nav-bar) { display: block; } }

  .primary-menu-button { display: inline-flex; align-items: center; gap: .4rem; flex-shrink: 0; min-height: 2.5rem; padding: 0 .75rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; background: transparent; color: var(--sl-color-white); font: inherit; font-size: var(--sl-text-sm); font-weight: 600; cursor: pointer; }
  .primary-menu-button[aria-expanded='true'] { background: var(--sl-color-accent-low); border-color: var(--sl-color-accent); }
  @media (min-width: 78rem) { .primary-menu-button { display: none; } }

  .primary-menu { position: fixed; inset: var(--sl-nav-height) 0 auto auto; margin: 0; width: min(100%, 22rem); max-height: calc(100dvh - var(--sl-nav-height)); overflow-y: auto; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-top: 0; border-radius: 0 0 0 .75rem; background: var(--sl-color-bg-nav); color: var(--sl-color-text); box-shadow: var(--sl-shadow-lg); }
  /* Two rules, so browsers without popovers (which drop any selector with :popover-open) still hide it. */
  .primary-menu:not([data-open]) { display: none; }
  .primary-menu:popover-open { display: block; }
  .primary-menu-prefs { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-gray-5); }
  .primary-menu-social { display: flex; gap: .5rem; align-items: center; }
  .primary-menu-social :global(a) { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; min-height: 2.75rem; }
  @media (max-width: 30rem) { .primary-menu { width: 100%; border-radius: 0; border-inline: 0; } }
  @media (max-width: 35rem) { .guide-header { gap: .5rem; } .primary-menu-button { padding: 0 .6rem; } }
</style>
