---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PokemonImage from './PokemonImage.astro';
import { speciesById } from '../lib/data';
import { SECTIONS, breadcrumbs } from '../lib/site-meta';
const path = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, '').length).split('/').filter(Boolean);
// Real section names (W-020); the same list feeds the BreadcrumbList JSON-LD in src/routeData.ts.
const crumbs = breadcrumbs(Astro.url.pathname, import.meta.env.BASE_URL, Astro.locals.starlightRoute.entry.data.title);
const section = SECTIONS[path[0]];
const showArt = section && path.length === 1 && path[0] !== 'trainers';
---
<div class="guide-page-heading">
  <div>
    <nav class="page-breadcrumb" aria-label="Breadcrumb"><ol>{crumbs.map((c, i) => i === crumbs.length - 1
      ? <li><span aria-current="page">{c.name}</span></li>
      : <li><a href={c.href}>{c.name}</a><span class="sep" aria-hidden="true">/</span></li>)}</ol></nav>
    <Default {...Astro.props} />
  </div>
  {showArt && <div class="page-heading-art" aria-hidden="true"><PokemonImage loading="eager" art="artwork" s={speciesById.get(section.mon)!} /></div>}
</div>
<style>
  .guide-page-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 7rem; }
  .guide-page-heading > div:first-child { min-width: 0; }
  .page-breadcrumb ol { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; font-size: .75rem; color: var(--sl-color-gray-3); }
  .page-breadcrumb li { margin: 0; display: flex; align-items: center; gap: .5rem; min-width: 0; }
  .page-breadcrumb li:last-child span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 40ch; }
  .page-breadcrumb a { display: inline-flex; align-items: center; min-height: 24px; text-decoration: none; color: inherit; }
  .page-breadcrumb a:hover { color: var(--sl-color-text-accent); text-decoration: underline; }
  .page-heading-art { flex: 0 0 108px; border-radius: 50%; background: radial-gradient(circle, var(--sl-color-accent-low), transparent 72%); }
  .page-heading-art :global(.pokemon-image-small) { width: 108px; height: 108px; }
  .page-heading-art :global(img) { width: 100%; height: 100%; }
  @media (max-width: 38rem) { .guide-page-heading { min-height: 5.5rem; } .page-heading-art { flex-basis: 76px; } .page-heading-art :global(.pokemon-image-small) { width: 76px; height: 76px; } }
</style>
