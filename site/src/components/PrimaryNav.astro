---
// The main destinations (src/lib/primary-nav.ts). `variant`: "bar" (header, wide screens), "panel" (the Menu panel)
// or "drawer" (top of the mobile sidebar drawer).
import { PRIMARY_NAV, navCurrent } from '../lib/primary-nav';
const { variant = 'bar' } = Astro.props as { variant?: 'bar' | 'panel' | 'drawer' };
const base = import.meta.env.BASE_URL;
const href = (h: string) => base.replace(/\/?$/, '') + h;
---
<nav class:list={['primary-nav', `primary-nav-${variant}`]} aria-label={variant === 'drawer' ? 'Main sections' : 'Main'}>
	<ul>
		{PRIMARY_NAV.map((item) => (
			<li><a href={href(item.href)} class:list={[{ 'primary-nav-cta': item.cta }]} aria-current={navCurrent(Astro.url.pathname, base, item.href)}>{item.label}</a></li>
		))}
	</ul>
</nav>
<style>
	.primary-nav ul { display: flex; list-style: none; margin: 0; padding: 0; }
	.primary-nav a { display: flex; align-items: center; min-height: 2.5rem; color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); font-weight: 600; text-decoration: none; white-space: nowrap; border-radius: .5rem; }
	.primary-nav a:hover { color: var(--sl-color-white); background: var(--sl-color-gray-6); }
	.primary-nav a[aria-current] { color: var(--sl-color-white); }
	.primary-nav a.primary-nav-cta { background: var(--sl-color-accent-high); color: var(--sl-color-bg); border: 1px solid transparent; }
	.primary-nav a.primary-nav-cta:hover { filter: brightness(1.12); background: var(--sl-color-accent-high); color: var(--sl-color-bg); }

	.primary-nav-bar ul { align-items: center; gap: .15rem; }
	.primary-nav-bar a { padding: 0 .7rem; }
	.primary-nav-bar a[aria-current]:not(.primary-nav-cta) { box-shadow: inset 0 -2px 0 var(--sl-color-text-accent); border-radius: .5rem .5rem 0 0; }
	.primary-nav-bar li:last-child { margin-inline-start: .5rem; }

	.primary-nav-panel ul, .primary-nav-drawer ul { flex-direction: column; gap: .15rem; }
	.primary-nav-panel a, .primary-nav-drawer a { min-height: 2.75rem; padding: 0 .85rem; font-size: 1rem; }
	.primary-nav-panel a[aria-current]:not(.primary-nav-cta), .primary-nav-drawer a[aria-current]:not(.primary-nav-cta) { background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
	.primary-nav-panel li:last-child, .primary-nav-drawer li:last-child { margin-top: .5rem; }
	.primary-nav-panel a.primary-nav-cta, .primary-nav-drawer a.primary-nav-cta { justify-content: center; }
	.primary-nav-drawer { padding-bottom: 1rem; border-bottom: 1px solid var(--sl-color-gray-5); }
	@media (min-width: 50rem) { .primary-nav-drawer { display: none; } }
</style>
