---
// Starlight's page banner, plus a fixed notice on preview builds (GUIDE_PREVIEW=1, see site.config.mjs).
import DefaultBanner from '@astrojs/starlight/components/Banner.astro';
import { PREVIEW, SITE_URL } from '../../site.config.mjs';
// Absolute, so the preview's own link check doesn't need the production pages.
const productionHome = new URL(import.meta.env.BASE_URL.replace(/preview\/$/, ''), SITE_URL).href;
---
{PREVIEW && <div class="preview-banner" role="note" data-pagefind-ignore>
  <strong>Preview build — not the released guide.</strong>{' '}
  Changes shown here are still being tested and may be wrong or change again.{' '}
  <a href={productionHome}>Go to the released guide</a>
</div>}
<DefaultBanner />
<style>
  .preview-banner {
    padding: .6rem var(--sl-nav-pad-x);
    background: #fde68a;
    color: #3b2f00;
    border-bottom: 2px solid #b45309;
    text-align: center;
    text-wrap: balance;
    line-height: var(--sl-line-height-headings);
  }
  .preview-banner a { color: inherit; font-weight: 600; }
</style>
