---
import shell from '../../../work/save-editor/index.html?raw';
import '../styles/save-editor.css';
// Reuse the controls, but let Starlight own the page title, main landmark and theme.
const main = shell.match(/<main\b[^>]*>([\s\S]*?)<\/main>/)?.[1];
if (!main) throw new Error('Save editor HTML must contain its existing main.');
const controls = main
  .replace(/<header\b[^>]*>[\s\S]*?<\/header>/, '')
  .replace(/<footer>[\s\S]*?<\/footer>/, '')
  .replace(/<p class="step">[\s\S]*?<\/p>/g, '')
  .replaceAll('Bring your adventure', 'Open a save')
  .replaceAll('Ready to head back?', 'Download your save');
---
<div class="save-editor not-content" set:html={controls} />
<script>
  import '../../../work/save-editor/src/app.ts';
</script>
