---
// Primo's Easy Chat passwords (Violet City Pokémon Center), shown inline in the guide
// (marker <!-- solver: primo-passwords --> in guide/08-cherrygrove-to-azalea.md).
// Data: site/src/data/primo.json, written by `python3 work/tools/primo_passwords.py --site`
// (English words from the translation banks). Encoder: src/lib/primo.mjs, checked against the
// Python tool for every Trainer ID by `node work/tools/site/test_primo.mjs`.
// Without JavaScript only the guide's own text shows (the form stays hidden).
---
<div class="primo not-content">
	<p class="primo-nojs">On the website, a calculator here works out the passwords for your Trainer ID (it needs JavaScript).</p>
	<form class="primo-form" hidden onsubmit="return false">
		<p class="primo-title">Primo's passwords for your game</p>
		<label class="primo-field">
			<span>Your Trainer ID</span>
			<input class="primo-tid" type="text" inputmode="numeric" autocomplete="off" maxlength="5" pattern="[0-9]*" placeholder="e.g. 12345" aria-describedby="primo-hint" />
		</label>
		<p class="primo-hint" id="primo-hint">
			The five-digit <strong>ID No.</strong> on your Trainer Card (0–65535). Only this number counts; nothing else about your game changes the passwords.
		</p>
		<p class="primo-error" role="alert" hidden>Enter a number from 0 to 65535.</p>
		<p class="sr-only primo-status" role="status" aria-live="polite" aria-atomic="true"></p>
		<div class="primo-out" hidden>
			<p class="primo-how">
				Tell Primo <strong>phrase 1</strong>, then <strong>phrase 2</strong>, two words each. In the Easy Chat word picker,
				open the category shown under each word and pick the word at that number (#1 is the first word in the category).
				The picker isn't in A–Z order, so the number is the quickest way to find each word.
			</p>
			<ul class="primo-list"></ul>
			<p class="primo-note">
				Each reward works once. The Eggs need a free space in your party; a wallpaper appears with the Box wallpapers.{' '}
				<strong>Not confirmed in game:</strong> worked out from the game's own password check, but not yet tried in a playthrough.
			</p>
		</div>
	</form>
</div>

<style is:global>
	.primo { margin: 1rem 0 1.25rem; }
	.primo [hidden] { display: none !important; }
	.primo-nojs { font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	.primo-form {
		border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; padding: 1rem 1.25rem;
		background: var(--sl-color-gray-7, var(--sl-color-black)); color: var(--sl-color-gray-2);
	}
	.primo-form p { margin: 0; }
	.primo-title { font-weight: 700; color: var(--sl-color-white); margin-bottom: 0.75rem !important; }
	.primo-field { display: inline-grid; gap: 0.25rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-white); }
	.primo-tid {
		font: inherit; font-family: var(--__sl-font-mono, monospace); font-size: var(--sl-text-xl); font-weight: 700; letter-spacing: 0.08em;
		width: 8ch; box-sizing: content-box; color: var(--sl-color-white); background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-4); border-radius: 0.4rem; padding: 0.3rem 0.6rem;
	}
	.primo-tid:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
	.primo-tid[aria-invalid='true'] { border-color: var(--sl-color-red, #d93b3b); }
	.primo-hint, .primo-note, .primo-how { font-size: var(--sl-text-sm); margin-top: 0.5rem !important; }
	.primo-error { font-size: var(--sl-text-sm); color: var(--sl-color-red-high, #d93b3b); margin-top: 0.5rem !important; }
	.primo-out { margin-top: 1rem; }
	.primo-list { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.5rem; }
	.primo-row {
		display: grid; grid-template-columns: minmax(8.5rem, 1fr) 2fr 2fr; gap: 0.5rem 0.75rem; align-items: center;
		padding: 0.6rem 0.75rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: var(--sl-color-bg);
	}
	.primo-reward { font-weight: 700; color: var(--sl-color-white); }
	.primo-reward small { display: block; font-weight: 400; font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.primo-phrase { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: baseline; }
	.primo-pn { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); width: 100%; }
	.primo-word {
		display: inline-grid; padding: 0.2rem 0.5rem; border-radius: 0.35rem; min-width: 6.5rem;
		border: 1px solid var(--sl-color-gray-5); background: var(--sl-color-gray-7, var(--sl-color-black));
	}
	.primo-w { font-weight: 700; color: var(--sl-color-white); }
	.primo-where { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.primo-w { overflow-wrap: normal; word-break: normal; }
	@media (max-width: 40rem) {
		.primo-form { padding: 0.75rem; }
		.primo-row { grid-template-columns: 1fr; align-items: start; }
		.primo-phrase { gap: 0.3rem; }
		.primo-word { min-width: 0; flex: 1 1 0; padding: 0.2rem 0.4rem; }
		.primo-w { font-size: var(--sl-text-sm); }
	}
	@media print {
		.primo { display: none; }
	}
</style>

<script>
	import data from '../data/primo.json';
	import { encodeIndices } from '../lib/primo.mjs';

	type Word = { id: number; en: string; category: string; position: number };
	const words = data.words as Word[];
	const N = words.length;
	const KEY = 'ohg:primo-tid';
	const seen = new Map<string, number>();
	for (const w of words) seen.set(w.en, (seen.get(w.en) || 0) + 1);

	const el = (tag: string, cls: string, text?: string) => {
		const e = document.createElement(tag);
		if (cls) e.className = cls;
		if (text !== undefined) e.textContent = text;
		return e;
	};

	for (const root of document.querySelectorAll<HTMLElement>('.primo')) {
		const form = root.querySelector<HTMLFormElement>('.primo-form')!;
		const input = root.querySelector<HTMLInputElement>('.primo-tid')!;
		const out = root.querySelector<HTMLElement>('.primo-out')!;
		const list = root.querySelector<HTMLElement>('.primo-list')!;
		const err = root.querySelector<HTMLElement>('.primo-error')!;
		const status = root.querySelector<HTMLElement>('.primo-status')!;

		const wordBox = (w: Word) => {
			const box = el('span', 'primo-word');
			box.append(el('span', 'primo-w', w.en));
			box.append(el('span', 'primo-where', `${w.category} · #${w.position}`));
			const n = seen.get(w.en) || 0;
			if (n > 1) box.append(el('span', 'primo-where', `one of ${n} “${w.en}” words`));
			return box;
		};

		const update = () => {
			const raw = input.value.trim();
			const ok = /^\d{1,5}$/.test(raw) && Number(raw) <= 65535;
			input.setAttribute('aria-invalid', String(raw !== '' && !ok));
			err.hidden = raw === '' || ok;
			out.hidden = !ok;
			list.replaceChildren();
			if (!ok) {
				status.textContent = '';
				return;
			}
			const tid = Number(raw);
			try { localStorage.setItem(KEY, String(tid)); } catch { /* private mode */ }
			const spoken: string[] = [];
			for (const r of data.rewards) {
				const idx = encodeIndices(tid, r.value, N, data.marker, data.rotate_all_bits);
				const w = idx.map((i: number) => words[i]);
				const li = el('li', 'primo-row');
				const name = el('span', 'primo-reward', r.en);
				name.append(el('small', '', r.kind === 'egg' ? 'Egg, once' : 'Box wallpaper, once'));
				li.append(name);
				[[w[0], w[1]], [w[2], w[3]]].forEach((pair, p) => {
					const ph = el('span', 'primo-phrase');
					ph.append(el('span', 'primo-pn', `Phrase ${p + 1}`), wordBox(pair[0]), wordBox(pair[1]));
					li.append(ph);
				});
				list.append(li);
				spoken.push(`${r.en}: ${w[0].en} ${w[1].en}, then ${w[2].en} ${w[3].en}`);
			}
			status.textContent = `Trainer ID ${tid}. ` + spoken.join('. ') + '.';
		};

		input.addEventListener('input', update);
		try {
			const saved = localStorage.getItem(KEY);
			if (saved && /^\d{1,5}$/.test(saved)) input.value = saved;
		} catch { /* private mode */ }
		root.querySelector('.primo-nojs')?.setAttribute('hidden', '');
		form.hidden = false;
		update();
	}
</script>
