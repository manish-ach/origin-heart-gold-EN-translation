---
// The home page hero. Any other page with `hero` frontmatter gets Starlight's own hero.
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import PokemonImage from './PokemonImage.astro';
import { speciesById, url } from '../lib/data';
import { OFFICIAL_SITE_SENTENCE, latestRelease, formatDate } from '../lib/site-meta';
const isHome = Astro.url.pathname === import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{isHome ? <section class="home-hero">
  <div class="home-hero-copy">
    <p class="eyebrow">ENGLISH TRANSLATION PATCH</p>
    <h1 id="_top"><span class="home-h1-pre">Pokémon</span> Origin <span class="home-h1-gold">HeartGold</span><span class="sr-only"> — </span> <span class="home-h1-sub">English translation</span></h1>
    <p class="home-description">{OFFICIAL_SITE_SENTENCE} Official patches come only from our GitHub releases, and you can apply them to your own HeartGold right here in your browser. Then follow the walkthrough, find every Pokémon and build your team.</p>
    <div class="home-actions"><a class="guide-button" href={url('/patch/')}>Download the English patch <span aria-hidden="true">→</span></a><a class="home-secondary" href={url('/guide/')}>Start the walkthrough <span aria-hidden="true">→</span></a></div>
    <p class="home-release"><span>English patch <strong>v{latestRelease.version}</strong></span><span><span aria-hidden="true">· </span>Released <time datetime={latestRelease.date}>{formatDate(latestRelease.date)}</time></span><span><span aria-hidden="true">· </span><a href={url('/changelog/')}>What’s new</a></span></p>
    <p class="home-version">Based on <span lang="zh-Hans">起源心金</span> v4.0.3 <span class="sep" aria-hidden="true">·</span> Free and fan-made</p>
  </div>
  <div class="home-art" aria-hidden="true"><div class="home-art-orbit"></div><PokemonImage loading="eager" s={speciesById.get(250)!} /><div class="home-art-companion"><PokemonImage loading="eager" s={speciesById.get(152)!} /><PokemonImage loading="eager" s={speciesById.get(155)!} /><PokemonImage loading="eager" s={speciesById.get(158)!} /></div></div>
</section> : <DefaultHero />}
<style>
  .home-hero { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: center; padding-block: 3rem 2rem; }
  .home-hero h1#_top { font-size: clamp(3rem, 5.6vw, 5rem); letter-spacing: -.065em; line-height: .98; font-weight: 800; margin: 1.25rem 0 1.5rem; }
  .home-hero h1 .home-h1-gold { display: block; color: var(--sl-color-text-accent); }
  .home-hero h1 .home-h1-pre { display: block; font-size: .3em; letter-spacing: .02em; font-weight: 700; color: var(--sl-color-gray-2); margin-bottom: .35em; }
  .home-hero h1 .home-h1-sub { display: block; font-size: .36em; letter-spacing: -.02em; font-weight: 650; color: var(--sl-color-white); margin-top: .5em; }
  .home-release { display: flex; flex-wrap: wrap; gap: .25rem .6rem; font-size: .85rem; color: var(--sl-color-gray-2); margin-top: 1.25rem; }
  .home-release a { color: var(--sl-color-text-accent); }
  .home-description { color: var(--sl-color-gray-2); max-width: 44ch; line-height: 1.8; font-size: 1rem; }
  .home-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }
  .home-secondary { color: var(--sl-color-text-accent); font-size: .9rem; text-underline-offset: .25em; }
  .home-version { font-size: .7rem; color: var(--sl-color-gray-3); margin-top: 1.5rem; }
  .home-version .sep { margin-inline: .4rem; }
  .home-art { position: relative; min-width: 0; padding-bottom: 5.5rem; }
  .home-art-orbit { position: absolute; inset: 5% 0 15%; border: 1px solid var(--sl-color-accent-low); border-radius: 50%; background: radial-gradient(circle, var(--sl-color-accent-low), transparent 68%); }
  .home-art > :global(.pokemon-image-small) { position: relative; width: 100%; height: auto; transform: rotate(-5deg); filter: drop-shadow(0 15px 15px rgb(0 0 0 / .12)); }
  .home-art :global(img) { width: 100%; height: auto; }
  .home-art-companion { position: absolute; bottom: 0; left: 5%; right: 5%; display: flex; align-items: end; justify-content: center; }
  .home-art-companion :global(.pokemon-image-small) { width: 32%; height: auto; flex: 0 1 32%; }
  @media (max-width: 50rem) { .home-hero { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 1.5rem 0; } .home-hero h1#_top { font-size: clamp(3.6rem, 13vw, 5.8rem); } .home-art { width: min(80%, 270px); margin-inline: auto; padding-bottom: 3.5rem; } }
</style>
