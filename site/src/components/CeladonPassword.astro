---
// Persian statue password for the Team Rocket base under the Celadon Game Corner, shown inline in the
// guide (marker <!-- solver: celadon-password --> in guide/03-vermilion-to-celadon.md).
// Source: script file 172 (weekday branches from L4529, hour check L10419). Weekday 0 = Sunday,
// as in the game's GetWeekday; any other weekday (Monday, Tuesday) falls through to the same code.
// Without JavaScript the form stays hidden and the guide's own weekday/hour table answers the question.
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const CODES = ['1654', '2431', '2431', '4365', '5412', '2513', '3465'];
const COLOURS = ['Red', 'Orange', 'Yellow', 'Green', 'Blue', 'Purple'];
const pad = (h: number) => String(h).padStart(2, '0');
---
<div class="celpw not-content" data-codes={CODES.join(',')}>
	<form class="celpw-form" hidden onsubmit="return false">
		<p class="celpw-title">Password calculator</p>
		<div class="celpw-inputs">
			<label>
				<span>In-game day</span>
				<select name="day" class="celpw-day">
					{DAYS.map((d, i) => <option value={i}>{d}</option>)}
				</select>
			</label>
			<label>
				<span>In-game hour</span>
				<select name="hour" class="celpw-hour">
					{Array.from({ length: 24 }, (_, h) => <option value={h}>{pad(h)}:00–{pad(h)}:59</option>)}
				</select>
			</label>
			<button type="button" class="celpw-now">Use this device's clock</button>
		</div>
		<p class="celpw-clock">
			The game reads the clock of your DS or emulator, not this page. The fields start at this device's time;
			if the game's clock is different, pick the day and hour shown in the game.
		</p>

		<p class="sr-only celpw-status" role="status" aria-live="polite" aria-atomic="true"></p>
		<div class="celpw-out">
			<p class="celpw-label">Password</p>
			<p class="celpw-code"><span class="celpw-code-text">-----</span></p>
			<ol class="celpw-digits" aria-label="Digits in entry order">
				{[0, 1, 2, 3, 4].map((i) => (
					<li class="celpw-digit">
						<span class="celpw-pos">Digit {i + 1}</span>
						<span class="celpw-num">-</span>
						<span class="celpw-swatch" aria-hidden="true"></span>
						<span class="celpw-colour">-</span>
					</li>
				))}
			</ol>
			<p class="celpw-next"></p>
		</div>

		<p class="celpw-colours">
			Each digit is a colour from the clues on that floor:
			{COLOURS.map((c, i) => <><span class="celpw-chip" data-d={i + 1}><span class="celpw-swatch" aria-hidden="true"></span>{i + 1} {c}</span>{' '}</>)}
		</p>
	</form>
</div>

<style>
	.celpw { margin: 1rem 0 1.25rem; --celpw-1: #d93b3b; --celpw-2: #ee8a1c; --celpw-3: #e8c51c; --celpw-4: #3fa34d; --celpw-5: #3576d6; --celpw-6: #8a4fc7; }
	.celpw [hidden] { display: none !important; }
	.celpw-form {
		border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; padding: 1rem 1.25rem;
		background: var(--sl-color-gray-7, var(--sl-color-black));
	}
	.celpw-title { font-weight: 700; color: var(--sl-color-white); margin: 0 0 0.75rem !important; }
	.celpw-inputs { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; align-items: end; }
	.celpw-inputs label { display: grid; gap: 0.25rem; font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-white); margin: 0 !important; }
	.celpw-inputs select, .celpw-now {
		font: inherit; font-weight: 400; font-size: var(--sl-text-base); color: var(--sl-color-white); background: var(--sl-color-bg);
		border: 1px solid var(--sl-color-gray-4); border-radius: 0.4rem; padding: 0.35rem 0.6rem; margin: 0 !important;
	}
	.celpw-now { cursor: pointer; font-size: var(--sl-text-sm); }
	.celpw-now:hover { border-color: var(--sl-color-text-accent); }
	.celpw-inputs select:focus-visible, .celpw-now:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; }
	.celpw-clock { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin: 0.75rem 0 0 !important; }
	.celpw-out { margin-top: 1rem !important; }
	.celpw-label { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin: 0 !important; text-transform: uppercase; letter-spacing: 0.08em; }
	.celpw-code { margin: 0 !important; }
	.celpw-code-text {
		font-family: var(--__sl-font-mono, monospace); font-size: 2.5rem; font-weight: 700; letter-spacing: 0.3em;
		color: var(--sl-color-text-accent); line-height: 1.2;
	}
	.celpw-digits { list-style: none; padding: 0 !important; margin: 0.75rem 0 0 !important; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.5rem; }
	.celpw-digit {
		margin: 0 !important; display: grid; justify-items: center; gap: 0.2rem; padding: 0.5rem 0.25rem;
		border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: var(--sl-color-bg);
	}
	.celpw-pos { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	.celpw-num { font-family: var(--__sl-font-mono, monospace); font-size: 1.75rem; font-weight: 700; color: var(--sl-color-white); line-height: 1.1; }
	.celpw-colour { font-size: var(--sl-text-sm); font-weight: 600; color: var(--sl-color-white); }
	.celpw-swatch { display: inline-block; width: 1.6rem; height: 0.5rem; border-radius: 999px; background: var(--sl-color-gray-5); border: 1px solid var(--sl-color-gray-4); }
	.celpw-digit[data-d='1'] .celpw-swatch, .celpw-chip[data-d='1'] .celpw-swatch { background: var(--celpw-1); }
	.celpw-digit[data-d='2'] .celpw-swatch, .celpw-chip[data-d='2'] .celpw-swatch { background: var(--celpw-2); }
	.celpw-digit[data-d='3'] .celpw-swatch, .celpw-chip[data-d='3'] .celpw-swatch { background: var(--celpw-3); }
	.celpw-digit[data-d='4'] .celpw-swatch, .celpw-chip[data-d='4'] .celpw-swatch { background: var(--celpw-4); }
	.celpw-digit[data-d='5'] .celpw-swatch, .celpw-chip[data-d='5'] .celpw-swatch { background: var(--celpw-5); }
	.celpw-digit[data-d='6'] .celpw-swatch, .celpw-chip[data-d='6'] .celpw-swatch { background: var(--celpw-6); }
	.celpw-digit:last-child { border-color: var(--sl-color-text-accent); }
	.celpw-next { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin: 0.75rem 0 0 !important; }
	.celpw-colours { font-size: var(--sl-text-sm); margin-top: 1rem !important; }
	.celpw-chip { display: inline-flex; align-items: center; gap: 0.35rem; white-space: nowrap; margin-right: 0.5rem; }
	.celpw-chip .celpw-swatch { width: 0.8rem; height: 0.8rem; }
	@media print {
		.celpw { display: none; }
	}
	@media (max-width: 30rem) {
		.celpw-form { padding: 0.75rem; }
		.celpw-code-text { font-size: 2rem; letter-spacing: 0.2em; }
		.celpw-digits { gap: 0.3rem; }
		.celpw-num { font-size: 1.4rem; }
		.celpw-pos { font-size: 0.65rem; }
		.celpw-colour { font-size: var(--sl-text-xs); }
		.celpw-swatch { width: 1.1rem; }
	}
</style>

<script>
	const COLOURS = ['Red', 'Orange', 'Yellow', 'Green', 'Blue', 'Purple'];
	const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
	const pad = (h: number) => String(h).padStart(2, '0');

	for (const root of document.querySelectorAll<HTMLElement>('.celpw')) {
		const codes = (root.dataset.codes || '').split(',');
		const form = root.querySelector<HTMLFormElement>('.celpw-form')!;
		const day = root.querySelector<HTMLSelectElement>('.celpw-day')!;
		const hour = root.querySelector<HTMLSelectElement>('.celpw-hour')!;
		const codeText = root.querySelector<HTMLElement>('.celpw-code-text')!;
		const boxes = [...root.querySelectorAll<HTMLElement>('.celpw-digit')];
		const next = root.querySelector<HTMLElement>('.celpw-next')!;
		const status = root.querySelector<HTMLElement>('.celpw-status')!;

		// Weekday 0 = Sunday (the game's GetWeekday and JavaScript's getDay agree); hour block of 4 gives the last digit.
		const code = (d: number, h: number) => codes[d] + String(Math.floor(h / 4) + 1);

		const update = () => {
			const d = Number(day.value), h = Number(hour.value);
			const c = code(d, h);
			codeText.textContent = c;
			c.split('').forEach((ch, i) => {
				const n = Number(ch);
				const box = boxes[i];
				box.dataset.d = ch;
				box.querySelector('.celpw-num')!.textContent = ch;
				box.querySelector('.celpw-colour')!.textContent = COLOURS[n - 1];
			});
			// The last digit changes every 4 hours; at midnight the weekday (and maybe the first four digits) change too.
			const blockEnd = Math.floor(h / 4) * 4 + 4;
			const nd = blockEnd === 24 ? (d + 1) % 7 : d;
			const nh = blockEnd % 24;
			const nc = code(nd, nh);
			next.textContent = `Valid ${pad(Math.floor(h / 4) * 4)}:00–${pad(blockEnd - 1)}:59. ` +
				`The code changes at ${pad(nh)}:00${blockEnd === 24 ? ` (${DAYS[nd]})` : ''}: it becomes ${nc}. ` +
				'Close to that time, check the in-game clock before you enter it.';
			status.textContent = `${DAYS[d]}, ${pad(h)}:00: password ${c.split('').join(' ')} (` +
				c.split('').map((ch) => COLOURS[Number(ch) - 1]).join(', ') + ').';
		};

		const useNow = () => {
			const now = new Date();
			day.value = String(now.getDay());
			hour.value = String(now.getHours());
			update();
		};

		day.addEventListener('change', update);
		hour.addEventListener('change', update);
		root.querySelector('.celpw-now')!.addEventListener('click', useNow);
		form.hidden = false;
		useNow();
	}
</script>
