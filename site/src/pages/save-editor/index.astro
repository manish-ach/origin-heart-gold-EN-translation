---
// The guide site's copy of the standalone save editor (work/save-editor). Its HTML shell is reused as is and dressed as
// part of the site here (W-034): the site's title, description, canonical and social tags, the site's wordmark and an
// h1, the site's font stack instead of Google Fonts, the site's theme choice, a backup note and the site footer text.
import shell from '../../../../work/save-editor/index.html?raw';
import '../../../../work/save-editor/styles.css';
import { PREVIEW, SITE_URL, REPO_URL } from '../../../site.config.mjs';
import { SITE_NAME, SOCIAL_IMAGE, composeTitle } from '../../lib/site-meta';
import { organization, website } from '../../routeData';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prodBase = PREVIEW ? base.replace(/preview\/$/, '') : base;
const abs = (path: string) => new URL(path, SITE_URL).href;
const title = composeTitle('Save editor');
const description = 'Edit your Origin HeartGold v4.0.3 (English) save in your browser: party, PC boxes, trainer and bag. Nothing is uploaded; export an edited copy and keep your original.';
const canonical = abs(`${prodBase}save-editor/`);
const image = abs(`${prodBase}${SOCIAL_IMAGE.path}`);
const escapeAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [organization, website, {
		'@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: 'Save editor', description, inLanguage: 'en',
		isPartOf: { '@id': `${abs(prodBase)}#website` }, publisher: { '@id': `${abs(prodBase)}#organization` },
		breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: abs(prodBase) },
			{ '@type': 'ListItem', position: 2, name: 'Save editor', item: canonical },
		] },
	}],
}).replace(/</g, '\\u003c');
const meta = [
	`<link rel="canonical" href="${canonical}">`,
	`<meta property="og:title" content="Save editor">`,
	`<meta property="og:description" content="${escapeAttr(description)}">`,
	`<meta property="og:type" content="website">`, `<meta property="og:locale" content="en_US">`,
	`<meta property="og:site_name" content="${escapeAttr(SITE_NAME)}">`, `<meta property="og:url" content="${canonical}">`,
	`<meta property="og:image" content="${image}">`, `<meta property="og:image:width" content="${SOCIAL_IMAGE.width}">`,
	`<meta property="og:image:height" content="${SOCIAL_IMAGE.height}">`, `<meta property="og:image:alt" content="${escapeAttr(SOCIAL_IMAGE.alt)}">`,
	`<meta name="twitter:card" content="summary_large_image">`, `<meta name="twitter:image" content="${image}">`,
	`<meta name="twitter:image:alt" content="${escapeAttr(SOCIAL_IMAGE.alt)}">`,
	`<meta name="theme-color" content="#efece5" media="(prefers-color-scheme: light)">`,
	`<meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)">`,
	PREVIEW ? `<meta name="robots" content="noindex, nofollow">` : '',
	`<script type="application/ld+json">${jsonLd}</script>`,
].join('');
const head = shell.match(/<head>([\s\S]*?)<\/head>/)?.[1]
	// No third-party fonts (privacy, speed): the site's own font stack is set below (W-054).
	.replace(/<link[^>]*fonts\.(googleapis|gstatic)\.com[^>]*>/g, '')
	.replace(/<link rel="stylesheet"[^>]*>/g, '')
	.replace(/<title>[\s\S]*?<\/title>/, `<title>${title}</title>`)
	.replace(/<meta name="description"[^>]*>/, `<meta name="description" content="${escapeAttr(description)}">${meta}`)
	// The site's theme choice (Starlight's key), so light/dark follows the rest of the site.
	.replace(/'ohg-editor-theme'/g, "'starlight-theme'")
	// The site's own icon set, so the save editor looks like part of the site (W-025).
	.replace(/<link rel="icon"[^>]*>/, `<link rel="icon" href="${base}favicon.ico" sizes="32x32"><link rel="icon" type="image/svg+xml" href="${base}favicon.svg"><link rel="apple-touch-icon" href="${base}apple-touch-icon.png"><link rel="manifest" href="${base}site.webmanifest">`);
const brand = shell.match(/<div class="brand">[\s\S]*?<\/div>/)?.[0];
const drop = shell.match(/<p class="drop-sub">[\s\S]*?<\/p>/)?.[0];
const body = shell.match(/<body>([\s\S]*?)<\/body>/)?.[1]
	.replace(/<script[^>]*>[\s\S]*?<\/script>/g, '')
	.replace(brand ?? '\0', `<div class="brand"><a class="site-brand" href="${base}" aria-label="Origin HeartGold English home">ORIGIN <strong>HEARTGOLD</strong></a><h1 class="brand-title">Save editor</h1></div>`)
	.replace(drop ?? '\0', `${drop}<p class="drop-note">Keep a copy of your original save, and load the edited one only after you have checked it. Questions? See the <a href="${base}faq/">FAQ</a>.</p>`)
	.replace('<div class="bar-actions">', `<div class="bar-actions"><a class="btn ghost guide-link" href="${base}">Guide</a>`);
if (!head || !body || !brand || !drop) throw new Error('Save editor HTML must contain head, body, the brand and the drop zone.');
---
<!doctype html>
<html lang="en" data-theme-key="starlight-theme">
	<head><Fragment set:html={head} /></head>
	<body>
		<Fragment set:html={body} />
		<footer class="site-footer">
			<p>Part of the <a href={base}>Origin HeartGold English</a> site · <a href={`${base}faq/`}>FAQ</a> · <a href={`${REPO_URL}/issues/new?template=guide-problem.yml&page=${encodeURIComponent(`${base}save-editor/`)}&title=${encodeURIComponent('[Save editor] ')}`} rel="noopener">Report a problem</a></p>
			<p>A free, non-commercial fan project. Not affiliated with or endorsed by Nintendo, Creatures Inc., GAME FREAK inc. or The Pokémon Company.</p>
		</footer>
		<script>
			import '../../../../work/save-editor/src/ui/app.ts';
		</script>
	</body>
</html>
<style is:global>
	/* The site's font stack and wordmark; see src/components/SiteTitle.astro. */
	html:root { --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
	.brand { gap: .75rem; min-width: 0; }
	.site-brand { color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 750; letter-spacing: -.025em; white-space: nowrap; }
	.site-brand strong { color: var(--accent); }
	.brand-title { margin: 0; padding-left: .75rem; border-left: 1px solid var(--line-strong); font-size: 14px; font-weight: 500; color: var(--ink-2); white-space: nowrap; }
	.drop-note { margin: -8px 0 22px; color: var(--ink-2); font-size: 13px; }
	.drop-note a, .site-footer a { color: var(--accent); }
	.site-footer { max-width: 560px; margin: 48px auto 0; padding: 0 20px 96px; color: var(--ink-2); font-size: 12px; text-align: center; }
	.site-footer p { margin: 0 0 6px; }
	@media (max-width: 480px) { .brand-title { font-size: 13px; padding-left: .5rem; } }
</style>
