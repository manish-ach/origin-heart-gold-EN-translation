---
// Computed from species.json and official_species.json (lib/species-changes.ts); nothing here is typed by hand.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Type from '../../components/Type.astro';
import { speciesChanges, grouped, slugOf } from '../../lib/species-changes';
import { availabilityLabel, url } from '../../lib/data';
const changed = speciesChanges.filter((c) => c.typesChanged);
const shown = changed.filter((c) => c.availability === 'documented');
const other = changed.filter((c) => c.availability !== 'documented');
const groups = grouped(shown);
const title = (name: string) => name === 'Official forms' || name === 'Custom forms' ? name : `${name} Pokémon`;
const headings = [...groups.map((g) => ({ depth: 2, slug: slugOf(g.name), text: title(g.name) })), ...(other.length ? [{ depth: 2, slug: 'not-obtainable', text: 'Not obtainable in normal play' }] : [])];
---
<StarlightPage frontmatter={{ title: 'Type changes', description: 'Every Pokémon and form whose typing in Origin HeartGold differs from the official games.' }} headings={headings}>
<p>Origin HeartGold retypes a number of Pokémon. The tables list the {shown.length} species and forms you can get in the game whose typing differs from the official games. This is how the original Chinese hack works; the English patch changes none of it.</p>
<p>“Official” is the species’ latest official typing (with the Fairy type), so Clefairy being Fairy isn’t an Origin HeartGold change. Some alternate forms, such as Mega Blastoise, keep their official typing even where the base species changed. The <a href={url('/pokemon/')}>Pokémon pages</a> always show the typing you will actually meet. See also <a href={url('/stat-changes/')}>Base stat changes</a>.</p>
{groups.map((g) => <>
	<h2 id={slugOf(g.name)}>{title(g.name)} ({g.rows.length})</h2>
	{g.name === 'Custom forms' && <p>These forms exist only in Origin HeartGold; each is compared with its ordinary species.</p>}
	<table class="compact"><caption class="sr-only">Type changes: {title(g.name)}</caption><thead><tr><th>Pokémon</th><th>Official</th><th>Origin HeartGold</th></tr></thead>
	<tbody>{g.rows.map((c) => <tr>
		<td><a href={url(`/pokemon/${c.s.slug}/`)}>{c.s.name}</a>{c.comparedWith && <span class="small muted"> (vs {c.comparedWith.name})</span>}</td>
		<td>{c.officialTypes.map((t) => <Type type={t} />)}</td><td>{c.s.types.map((t) => <Type type={t} />)}</td></tr>)}</tbody></table>
</>)}
{other.length > 0 && <>
	<h2 id="not-obtainable">Not obtainable in normal play ({other.length})</h2>
	<p>These entries are also retyped, but the guide knows no way to get them in normal play.</p>
	<ul class="small">{other.map((c) => <li><a href={url(`/pokemon/${c.s.slug}/`)}>{c.s.name}</a> ({availabilityLabel(c.s)}): {c.officialTypes.join(' / ')} → {c.s.types.join(' / ')}</li>)}</ul>
</>}
</StarlightPage>
